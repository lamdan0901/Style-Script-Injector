{
  "manifest_version": 3,
  "name": "Better Bitbucket",
  "version": "1.0.0",
  "description": "Fixes Bitbucket PR tab strip position for easier navigation.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://bitbucket.org/*"],
      "css": ["styles.css"]
    }
  ]
}
